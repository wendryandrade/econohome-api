using EconoHome.Domain.Enums;

namespace EconoHome.Domain.Entities
{
    public class Category
    {
        public Guid Id { get; set; }
        public string Description { get; private set; } = string.Empty;
        public CategoryPurpose Purpose { get; private set; }

        // Construtor para o EF Core
        protected Category() { }

        public Category(string description, CategoryPurpose purpose)
        {
            Id = Guid.NewGuid();
            
            // REQUISITO DO TESTE: Descrição obrigatória com máximo de 400 caracteres
            if (string.IsNullOrWhiteSpace(description) || description.Length > 400)
                throw new ArgumentException("A descrição é obrigatória (máx 400 caracteres).");

            Description = description;
            Purpose = purpose;
        }

        public void Update(string description, CategoryPurpose purpose)
        {
            // REQUISITO DO TESTE: Descrição obrigatória com máximo de 400 caracteres
            if (string.IsNullOrWhiteSpace(description) || description.Length > 400)
                throw new ArgumentException("A descrição é obrigatória (máx 400 caracteres).");

            Description = description;
            Purpose = purpose;
        }

        /// <summary>
        /// Verifica se a categoria é compatível com o tipo de transação
        /// </summary>
        /// <param name="type">Tipo da transação (Income ou Expense)</param>
        /// <returns>True se compatível, False caso contrário</returns>
        /// <remarks>
        /// REGRA DE NEGÓCIO:
        /// - Categoria com Purpose = Both: Aceita qualquer tipo (Income ou Expense)
        /// - Categoria com Purpose = Income: Aceita apenas Income
        /// - Categoria com Purpose = Expense: Aceita apenas Expense
        /// A comparação (int)Purpose == (int)type funciona porque os enums têm valores correspondentes
        /// </remarks>
        public bool IsCompatibleWith(TransactionType type)
        {
            return Purpose == CategoryPurpose.Both || (int)Purpose == (int)type;
        }
    }
}